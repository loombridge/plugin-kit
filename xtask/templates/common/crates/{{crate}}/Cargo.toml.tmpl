[package]
name = "{{crate}}"
{{#instrument}}
description = "{{Name}}: a polyphonic instrument built on the plug-in kit."
{{/instrument}}
{{#effect}}
description = "{{Name}}: a stereo effect built on the plug-in kit."
{{/effect}}
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
publish.workspace = true

[lib]
# The cdylib is the CLAP plug-in (with its VST3 and Audio Unit entry points);
# the rlib lets its tests reach its types and its entry point, and makes
# Cargo build the cdylib beside them.
crate-type = ["cdylib", "rlib"]

[features]
default = ["export"]
# Its exports (CLAP natively, with VST3 and, on macOS, Audio Unit v2 made from
# it), with the agent interface, the generic editor and the standalone app. A
# host that compiles the plug-in in, as Beatlayer's native devices do, turns
# it off and gets the plug-in's types alone.
export = [
    "lspk-plugin/clap",
    "lspk-plugin/vst3",
    "lspk-plugin/auv2",
    "dep:lspk-ui",
    "dep:lspk-plugin-agent",
    "dep:lspk-standalone",
]

# The standalone app, which `cargo xtask bundle` lays out beside the
# plug-in's formats.
[[bin]]
name = "{{crate}}-standalone"
path = "src/main.rs"
required-features = ["export"]

[dependencies]
# Its own command.
lspk-commands.workspace = true
# Its parameters, in a parameter space.
lspk-params.workspace = true
# The `Plugin` trait; its formats come with `export`.
lspk-plugin.workspace = true
# The generic editor: every parameter drawn from its descriptor.
lspk-ui = { workspace = true, optional = true }
# The agent interface: its parameters and commands as tools, and its own MCP
# server, off until the person switches it on.
lspk-plugin-agent = { workspace = true, optional = true }
# Its command's arguments and results.
serde_json = "1"
# The standalone app.
lspk-standalone = { workspace = true, optional = true }

[dev-dependencies]
lspk-agent.workspace = true
lspk-rt.workspace = true
lspk-test.workspace = true

# Its benchmark scenarios, timed by `cargo xtask bench` and counted by CI's
# instruction-count gate.
[[bench]]
name = "perf"
harness = false

[lints]
workspace = true
